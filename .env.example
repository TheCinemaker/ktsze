# Környezeti változók — másold `.env`-re és töltsd ki.
# Netlify esetén: Site settings -> Environment variables.
#
# FONTOS: ide csak olyan érték kerülhet, ami nyilvános lehet. A VITE_ előtaggal
# ellátott változók BEKERÜLNEK a böngészőbe letöltött kódba. Titkot
# (service_role kulcs, adatbázis jelszó, API secret) SOHA ne tegyél ide.

# Supabase projekt URL
# Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co

# Supabase "anon public" kulcs
# Dashboard -> Project Settings -> API -> anon public
# Ez szándékosan publikus: a védelmet a Row Level Security adja, nem a kulcs.
VITE_SUPABASE_ANON_KEY=

# A rendszergazda e-mail címe. Belépésnél elég az "admin" szót beírni,
# a rendszer erre a címre oldja fel. Ha nincs megadva, a beépített
# alapérték: admin@visitkoszeg.hu
VITE_ADMIN_EMAIL=admin@visitkoszeg.hu
